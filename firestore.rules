rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isHouseMember(houseId) {
      return isAuthenticated() &&
        request.auth.uid in 
        get(/databases/$(database)/documents/houses/$(houseId)).data.members;
    }

    function isAddingSelf() {
      return isAuthenticated() &&
        resource.data.members.size() == request.resource.data.members.size() - 1 &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members.hasAll(resource.data.members) &&
        // Verificar que conoce el código de invitación
        request.resource.data.inviteCode == resource.data.inviteCode;
    }

    // Perfiles: solo el propio usuario
    match /users/{userId} {
      allow read, write: if isAuthenticated() 
        && request.auth.uid == userId;
    }

    // Códigos de invitación (lectura pública para permitir join)
    match /inviteCodes/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // rate-limited por Firestore
      allow update, delete: if false;
    }

    match /houses/{houseId} {
      // Crear casa: solo si te incluís como miembro
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 1
        && request.resource.data.members.size() <= 10;

      // Leer: solo miembros de la casa
      allow read: if isHouseMember(houseId);

      // Actualizar: miembros existentes o persona agregándose sola (con invite code)
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.members ||
        isAddingSelf()
      );

      // Nunca borrar una casa
      allow delete: if false;

      match /products/{productId} {
        allow read, write: if isHouseMember(houseId);
      }
      match /purchases/{purchaseId} {
        allow read, write: if isHouseMember(houseId);
        match /items/{itemId} {
          allow read, write: if isHouseMember(houseId);
        }
      }
      match /balances/{balanceId} {
        allow read, write: if isHouseMember(houseId);
      }
      match /notifications/{notificationId} {
        allow read, write: if isHouseMember(houseId);
      }
      match /auditLog/{logId} {
        allow read: if isHouseMember(houseId);
        allow create: if isHouseMember(houseId);
        allow update, delete: if false;
      }
      match /products/{productId}/stockMovements/{movementId} {
        allow read: if isHouseMember(houseId);
        allow write: if isHouseMember(houseId);
      }
    }
  }
}
